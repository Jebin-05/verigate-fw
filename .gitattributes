# Normalise line endings so the repo behaves identically on Linux, macOS and Windows.
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.bin binary
*.onnx binary
*.png binary
*.pdf binary
# terminal recordings (script) are binary-ish: keep bytes as they are
docs/demo/*.log -text
docs/demo/*.timing -text
