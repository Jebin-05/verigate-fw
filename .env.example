# Copy to .env — never commit .env. Values here are safe defaults for local dev only.
VERIGATE_ENV=local
# Blockchain
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Hardhat default account #0 — PUBLIC test key, local node only. NEVER put a real key here.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d96d4c9b98f
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Contract addresses are written here by `make contracts-deploy-local`
PUBLISHER_REGISTRY_ADDR=
FIRMWARE_REGISTRY_ADDR=
MODEL_REGISTRY_ADDR=
POLICY_CONTRACT_ADDR=
VERDICT_REGISTRY_ADDR=
# IPFS
IPFS_API=http://127.0.0.1:5001
IPFS_BACKEND=kubo            # kubo | local  (local = in-repo CID store, same CIDs)
# LLM explainer
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_ENABLED=true
# Vulnerability data (cached under data/processed/vulndb)
OSV_API=https://api.osv.dev/v1
VULN_CACHE_ONLY=false        # true = offline demo mode
# Ports (override if something on this machine already uses them)
HARDHAT_PORT=8545
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
OLLAMA_PORT=11434
GATEWAY_PORT=8000
DASHBOARD_PORT=5173
FLEET_SIZE=20
# Gateway
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=INFO
# Arbitrum Sepolia (evaluation only) — set via GitHub secrets / local .env, never here
# ARB_SEPOLIA_RPC_URL=
# ARB_SEPOLIA_DEPLOYER_KEY=
