# Copy to .env — never commit .env. Values here are safe defaults for local dev only.
VERIGATE_ENV=local
# Blockchain
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Hardhat default account #0 — PUBLIC test key, local node only. NEVER put a real key here.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Hardhat default account #2 — the demo publisher's transaction account (PUBLIC test key)
PUBLISHER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Publisher identity used by `verigate-publish` (Ed25519 signing key lives in KEYS_DIR, git-ignored)
PUBLISHER_DID=did:verigate:demo-publisher
KEYS_DIR=keys
# Contract addresses are written here by `make contracts-deploy-local`
PUBLISHER_REGISTRY_ADDR=
FIRMWARE_REGISTRY_ADDR=
MODEL_REGISTRY_ADDR=
POLICY_CONTRACT_ADDR=
VERDICT_REGISTRY_ADDR=
# Where deploy.ts writes addresses.json (read before the *_ADDR values above); relative to repo root
DEPLOYMENTS_DIR=contracts/deployments
# IPFS
IPFS_API=http://127.0.0.1:5001
IPFS_BACKEND=kubo            # kubo | local  (local = in-repo CID store, same CIDs)
LOCAL_IPFS_DIR=.verigate/ipfs-local   # blob store used by IPFS_BACKEND=local (git-ignored)
# LLM explainer
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_ENABLED=true
# Vulnerability data (cached under data/processed/vulndb)
OSV_API=https://api.osv.dev/v1
VULN_CACHE_ONLY=false        # true = offline demo mode
# Ports (override if something on this machine already uses them)
HARDHAT_PORT=8545
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
OLLAMA_PORT=11434
GATEWAY_PORT=8000
DASHBOARD_PORT=5173
FLEET_SIZE=20
# Gateway
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=INFO
# Arbitrum Sepolia (evaluation only) — set via GitHub secrets / local .env, never here
# ARB_SEPOLIA_RPC_URL=
# ARB_SEPOLIA_DEPLOYER_KEY=
