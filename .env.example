# Copy to .env — never commit .env. Values here are safe defaults for local dev only.
VERIGATE_ENV=local
# Blockchain
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Hardhat default account #0 — PUBLIC test key, local node only. NEVER put a real key here.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Hardhat default account #2 — the demo publisher's transaction account (PUBLIC test key)
PUBLISHER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Publisher identity used by `verigate-publish` (Ed25519 signing key lives in KEYS_DIR, git-ignored)
PUBLISHER_DID=did:verigate:demo-publisher
KEYS_DIR=keys
# Contract addresses are written here by `make contracts-deploy-local`
PUBLISHER_REGISTRY_ADDR=
FIRMWARE_REGISTRY_ADDR=
MODEL_REGISTRY_ADDR=
POLICY_CONTRACT_ADDR=
VERDICT_REGISTRY_ADDR=
# Where deploy.ts writes addresses.json (read before the *_ADDR values above); relative to repo root
DEPLOYMENTS_DIR=contracts/deployments
# IPFS
IPFS_API=http://127.0.0.1:5001
IPFS_BACKEND=kubo            # kubo | local  (local = in-repo CID store, same CIDs)
LOCAL_IPFS_DIR=.verigate/ipfs-local   # blob store used by IPFS_BACKEND=local (git-ignored)
# LLM explainer
OPENROUTER_URL=https://openrouter.ai/api/v1
# OpenRouter key from https://openrouter.ai/keys — empty turns the explainer off. NEVER commit a real key.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini  # any OpenRouter model that supports structured outputs (json_schema)
LLM_ENABLED=true
LLM_TIMEOUT_S=30              # per attempt; the explainer never blocks a device poll
LLM_AUTO_EXPLAIN=false        # false = the explanation is written only when asked (console button); true = after every release-level verdict
# Vulnerability data (cached under data/processed/vulndb)
OSV_API=https://api.osv.dev/v1
EPSS_URL=https://epss.empiricalsecurity.com
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
VULN_CACHE_ONLY=false        # true = offline demo mode (serve only what is cached below)
VULN_CACHE_DIR=data/processed/vulndb
# Ports (override if something on this machine already uses them)
HARDHAT_PORT=8545
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
GATEWAY_PORT=8000
DASHBOARD_PORT=5173
FLEET_SIZE=20
# Gateway
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=INFO
STATE_DIR=.verigate/state        # devices.json, verdicts.jsonl, listener cursor (git-ignored)
LISTENER_POLL_S=2                # NewRelease polling interval (seconds)
PROTOCOL_WINDOW_S=120            # accepted clock skew for signed device messages
STAGE2_MODEL_HASHES=0x67516bbe7ca4c051e0d4b147f4c0748f7c5d39a222f88f932b70b41ceeb7e5b2,0x53f5c172119b1c7d90bc649ecf12edd7efb57950b31196b60acba0851547c88f   # models/MANIFEST.sha256
MODELS_DIR=models                # ONNX files + cards + MANIFEST.sha256
SBOM_MODEL=sbom_risk.onnx        # empty disables the Stage-2 SBOM scorer
IMAGE_MODEL=image_anomaly.onnx   # empty disables the Stage-2 image scorer
STAGE2_EPSS_DATE=2025-09-18      # EPSS snapshot date used at inference (the model's T0)
BATCH_MAX_SIZE=50                # verdicts per Merkle batch (ADR-0005)
BATCH_MAX_WAIT_S=10              # or flush after this many seconds (ADR-0005)
REPUTATION_ALPHA_BP=1000         # EWMA weight of one receipt/reject, basis points (ADR-0006)
# Arbitrum Sepolia (evaluation only) — set via GitHub secrets / local .env, never here
# ARB_SEPOLIA_RPC_URL=
# ARB_SEPOLIA_DEPLOYER_KEY=
